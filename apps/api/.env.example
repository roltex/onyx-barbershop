PORT=4000
HOST=127.0.0.1
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
DB_CLIENT=sqlite
SQLITE_FILENAME=./onyx.sqlite
# Production: DB_CLIENT=mysql and DATABASE_URL=mysql://user:password@localhost:3306/onyx
DATABASE_URL=
# Optional SMTP. Without it, messages stay queued and can be inspected by managers.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Onyx Barbers <bookings@example.com>
# Set only when behind a trusted proxy; API should never be publicly exposed.
TRUST_PROXY=0
